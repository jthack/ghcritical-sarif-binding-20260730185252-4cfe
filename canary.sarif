{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "GHCritical Inert SARIF Scanner",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "GHCRITICAL-INERT-REF-BINDING",
              "name": "GHCriticalInertRefBinding",
              "shortDescription": {
                "text": "Owned inert ref-binding canary"
              },
              "properties": {
                "security-severity": "9.9",
                "tags": [
                  "security"
                ]
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "ghcritical-ref-binding/"
      },
      "results": [],
      "versionControlProvenance": [
        {
          "repositoryUri": "https://github.com/jtestappomni/ghcritical-sarif-binding-20260730185252-4cfe",
